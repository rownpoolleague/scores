<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Scoresheet</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="scoresheetrosters.js"></script>
    <script src="scoresheetinfo.js"></script>
<style>
/* --- Styles unchanged from your version --- */
/* --- Professional App Styles --- */
* { box-sizing: border-box; }
body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #0d1117; color: #fff; margin: 0; padding-bottom: 80px; }

.form-wrapper { width: 100%; padding: 10px; border: none; }

/* 1. Scoreboard Header */
.match-header {
    background: #161b22;
    border: 2px solid #1e90ff;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
}

.row { display: flex; justify-content: space-around; gap: 10px; margin-top: 0; }
select { 
    background: #0d1117; color: white; border: 1px solid #30363d; 
    padding: 8px; border-radius: 6px; width: 100%; font-size: 14px;
}

/* 2. Player Stat Cards */
.player-stats-container { 
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px; 
}
.player-stats-container::after { display: none; } /* Remove the old vertical line */

.stat-card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 10px;
    text-align: center;
}

.stat-card h3 { font-size: 16px; color: #4af; margin-bottom: 15px; height: 40px; display: flex; align-items: center; justify-content: center; }

/* 3. Stepper Logic (Better +/- Buttons) */
.innings-wrapper { 
    display: flex; align-items: center; justify-content: center; background: #0d1117; 
    border-radius: 8px; border: 1px solid #30363d; overflow: hidden; margin: 5px 0;
}
.innings-wrapper button { 
    flex: 1; border: none; background: transparent; color: #4af; 
    font-size: 20px; font-weight: bold; padding: 5px; height: 40px;
}
.innings-wrapper input { 
    width: 40px; background: transparent; color: white; border: none; 
    text-align: center; font-size: 18px; margin: 0; 
}

.stat-row { margin-bottom: 15px; }
.stat-row label { font-size: 12px; color: #8b949e; text-transform: uppercase; letter-spacing: 1px; }

/* 4. Bottom Action Bar (Fixed for mobile) */
.action-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: #161b22;
    padding: 10px;
    display: flex;
    gap: 8px;
    border-top: 1px solid #30363d;
    z-index: 1000;
}
.action-bar button {
    flex: 1; height: 45px; border-radius: 8px; border: none;
    font-size: 12px; font-weight: bold; background: #21262d; color: white;
}
.btn-primary { background: #1e90ff !important; }

/* Mobile Roster Boxes */
.roster-box { 
    font-size: 14px; background: #0d1117; border: 1px solid #30363d; 
    border-radius: 6px; margin-top: 8px; padding: 8px; 
}

/* Adjustments for the Submit Button */
#submitMatch {
    width: 100%; border-radius: 12px; margin: 20px 0;
}
</style>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"></script>
</head>
<body>
    <div id="loadingOverlay">
        <div class="spinner"></div>
        <div>Submitting Results...</div>
    </div>

    <div class="form-wrapper">
        <div class="match-header">
            <div id="teamScoreDisplay" style="text-align:center; font-size:20px; font-weight:bold; margin-bottom:15px; color:#1e90ff;">
                <span id="homeScore">0</span> <small style="color:#8b949e">vs</small> <span id="awayScore">0</span>
            </div>
            
            <div class="row">
                <div class="block" style="width: 45%;">
                    <select id="team">
                        <option value="">-- Home --</option>
                        <option>Halfway Crooks</option>
                        </select>
                    <div id="teamRoster" class="roster-box"></div>
                </div>
                <div class="block" style="width: 45%;">
                    <select id="opponent">
                        <option value="">-- Away --</option>
                        <option>Halfway Crooks</option>
                        </select>
                    <div id="opponentRoster" class="roster-box"></div>
                </div>
            </div>
        </div>

        <div style="display: flex; justify-content: center; align-items: center; gap: 20px; margin: 20px 0;">
            <div class="block">
                <label>Innings</label>
                <div class="innings-wrapper" style="width: 120px;">
                    <button type="button" onclick="changeInnings(-1)">−</button>
                    <input type="number" id="matchInnings" value="0" min="0">
                    <button type="button" onclick="changeInnings(1)">+</button>
                </div>
            </div>
            <div class="block">
                <label>Match Winner</label>
                <input id="matchWinner" readonly style="background:transparent; color:#00ff00; border:1px solid #30363d; border-radius:8px; height:40px; text-align:center; width:150px;">
            </div>
        </div>

        <div class="player-stats-container">
            <div class="stat-card">
                <h3 id="lagWinnerHeader">Winner</h3>
                <div class="stat-row">
                    <label>HC</label>
                    <div class="innings-wrapper"><button onclick="changePAHC(-1)">−</button><input id="pA_hc" value="0"><button onclick="changePAHC(1)">+</button></div>
                </div>
                <div class="stat-row">
                    <label>Wins</label>
                    <div class="innings-wrapper"><button onclick="changeWinsA(-1)">−</button><input id="pA_wins" value="0"><button onclick="changeWinsA(1)">+</button></div>
                </div>
                <div class="stat-row">
                    <label>Safety</label>
                    <div class="innings-wrapper"><button onclick="changePASafeties(-1)">−</button><input id="pA_safeties" value="0"><button onclick="changePASafeties(1)">+</button></div>
                </div>
                <div class="stat-row">
                    <label>8B / B+R / E8</label>
                    <div style="display:flex; gap:2px;">
                        <input id="pA_b8" value="0" style="width:30%; background:#0d1117; color:white; border:1px solid #333; text-align:center;">
                        <input id="pA_br" value="0" style="width:30%; background:#0d1117; color:white; border:1px solid #333; text-align:center;">
                        <input id="pA_e8" value="0" style="width:30%; background:#0d1117; color:white; border:1px solid #333; text-align:center;">
                    </div>
                </div>
                <div class="stat-row"><label>Coach</label> <input type="checkbox" id="pA_coach" onchange="saveNow()"></div>
            </div>

            <div class="stat-card">
                <h3 id="lagLoserHeader">Loser</h3>
                <div class="stat-row">
                    <label>HC</label>
                    <div class="innings-wrapper"><button onclick="changePBHC(-1)">−</button><input id="pB_hc" value="0"><button onclick="changePBHC(1)">+</button></div>
                </div>
                <div class="stat-row">
                    <label>Wins</label>
                    <div class="innings-wrapper"><button onclick="changeWinsB(-1)">−</button><input id="pB_wins" value="0"><button onclick="changeWinsB(1)">+</button></div>
                </div>
                <div class="stat-row">
                    <label>Safety</label>
                    <div class="innings-wrapper"><button onclick="changePBsafeties(-1)">−</button><input id="pB_safeties" value="0"><button onclick="changePBsafeties(1)">+</button></div>
                </div>
                <div class="stat-row">
                    <label>8B / B+R / E8</label>
                    <div style="display:flex; gap:2px;">
                        <input id="pB_b8" value="0" style="width:30%; background:#0d1117; color:white; border:1px solid #333; text-align:center;">
                        <input id="pB_br" value="0" style="width:30%; background:#0d1117; color:white; border:1px solid #333; text-align:center;">
                        <input id="pB_e8" value="0" style="width:30%; background:#0d1117; color:white; border:1px solid #333; text-align:center;">
                    </div>
                </div>
                <div class="stat-row"><label>Coach</label> <input type="checkbox" id="pB_coach" onchange="saveNow()"></div>
            </div>
        </div>

        <button id="submitMatch" style="display:none;background-color:#00FF00; color:#000; height:60px;">SUBMIT MATCH</button>
    </div>

    <div class="action-bar">
        <button onclick="exportScoresheet()" class="btn-primary">TRANSFER</button>
        <button onclick="toggleNotes()">NOTES</button>
        <button onclick="startTimer()">TIMER</button>
        <button onclick="showHistory()">HISTORY</button>
        <button onclick="addNewPlayerManual()">+ PLAYER</button>
    </div>

    <div style="text-align: center; margin-bottom: 30px;">
        <a href="index.html" style="color:#8b949e; text-decoration:none;">Back to Menu</a>
    </div>


    <script>
let isLoading = false;
const FORM_KEY = "scoresheetData";
let scores = JSON.parse(localStorage.getItem("teamMatchScores")) || { home: 0, away: 0 };
let flip = false;

// 1. Populate roster when team selects
function updateRoster(sel, div) {
    if (!sel.value) {
        div.innerHTML = "";
        return;
    }
    
    const rosterData = scoresheetinfo[sel.value] || [];
    
    div.innerHTML = rosterData.map(p => {
        // If name isn't in your scoresheetrosters.js file, it's a 3
        const lookupHC = scoresheetrosters[p];
        const hc = (lookupHC !== undefined && lookupHC !== 0) ? lookupHC : 3;

        return `<div class="playerName" data-p="${p}" data-hc="${hc}">
                    <span class="name">${p}</span>
                    <span class="hc">${hc}</span>
                </div>`;
    }).join("");
}
// 2. Event Listeners for Team Selection
document.getElementById("team").addEventListener("change", function() {
    updateRoster(this, document.getElementById("teamRoster"));
});
document.getElementById("opponent").addEventListener("change", function() {
    updateRoster(this, document.getElementById("opponentRoster"));
});

// 3. Player Selection Logic (Lag Winner/Loser)
document.addEventListener("click", e => {
    const playerDiv = e.target.closest(".playerName");
    if (!playerDiv) return;

    const name = playerDiv.getAttribute("data-p");
    const hc = playerDiv.getAttribute("data-hc");

    if (!flip) {
        document.getElementById("lagWinner").value = name;
        document.getElementById("pA_hc").value = hc;
        document.getElementById("lagWinnerHeader").textContent = name;
    } else {
        document.getElementById("lagLoser").value = name;
        document.getElementById("pB_hc").value = hc;
        document.getElementById("lagLoserHeader").textContent = name;
    }

    flip = !flip;
    saveNow();
});

// 4. Scoring UI Update
function updateScoreUI() {
    const hScore = document.getElementById("homeScore");
    const aScore = document.getElementById("awayScore");
    if (hScore && aScore) {
        hScore.textContent = scores.home;
        aScore.textContent = scores.away;
    }
}

// 5. Stat Increment/Decrement
function changeInnings(amount) {
    let input = document.getElementById("matchInnings");
    input.value = Math.max(0, (parseInt(input.value) || 0) + amount);
    saveNow();
}

function changeWinsA(amount) {
    let input = document.getElementById("pA_wins");
    input.value = Math.max(0, (parseInt(input.value) || 0) + amount);
    document.getElementById('pA_coach').checked = false;
    document.getElementById('pB_coach').checked = false;
    updateMatchWinner();
    saveNow();
}

function changeWinsB(amount) {
    let input = document.getElementById("pB_wins");
    input.value = Math.max(0, (parseInt(input.value) || 0) + amount);
    document.getElementById('pA_coach').checked = false;
    document.getElementById('pB_coach').checked = false;
    updateMatchWinner();
    saveNow();
}

// Utility functions for other stats
function changePASafeties(amount) { let input = document.getElementById("pA_safeties"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePA8B(amount) { let input = document.getElementById("pA_b8"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePABR(amount) { let input = document.getElementById("pA_br"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePAHC(amount) { let input = document.getElementById("pA_hc"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); updateMatchWinner(); saveNow(); }
function changePAE8(amount) { let input = document.getElementById("pA_e8"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePBHC(amount) { let input = document.getElementById("pB_hc"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); updateMatchWinner(); saveNow(); }
function changePBsafeties(amount) { let input = document.getElementById("pB_safeties"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePB8B(amount) { let input = document.getElementById("pB_b8"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePBBR(amount) { let input = document.getElementById("pB_br"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }
function changePBE8(amount) { let input = document.getElementById("pB_e8"); input.value = Math.max(0, (parseInt(input.value) || 0) + amount); saveNow(); }

// 6. Match Winner Logic
function updateMatchWinner() {
    const aWins = parseInt(document.getElementById("pA_wins").value) || 0;
    const bWins = parseInt(document.getElementById("pB_wins").value) || 0;
    const aHC = parseInt(document.getElementById("pA_hc").value) || 0;
    const bHC = parseInt(document.getElementById("pB_hc").value) || 0;
    const winField = document.getElementById("matchWinner");
    const subBtn = document.getElementById("submitMatch");

    if (aWins === aHC && aHC > 0) {
        winField.value = document.getElementById("lagWinner").value;
    } else if (bWins === bHC && bHC > 0) {
        winField.value = document.getElementById("lagLoser").value;
    } else {
        winField.value = "";
    }
    subBtn.style.display = winField.value ? "inline-block" : "none";
}

// 7. Submit to Google Sheets
document.getElementById("submitMatch").onclick = function() {
    const btn = this;
    const loader = document.getElementById("loadingOverlay");

    // Start Loading State
    btn.disabled = true;
    loader.style.display = "flex"; // Show the spinner overlay

    const data = {
        team: document.getElementById("team").value,
        opponent: document.getElementById("opponent").value,
        lagWinner: document.getElementById("lagWinner").value,
        lagLoser: document.getElementById("lagLoser").value,
        matchInnings: document.getElementById("matchInnings").value,
        pA: {
            handicap: document.getElementById("pA_hc").value,
            wins: document.getElementById("pA_wins").value,
            safeties: document.getElementById("pA_safeties").value,
            b8: document.getElementById("pA_b8").value,
            br: document.getElementById("pA_br").value,
            e8: document.getElementById("pA_e8").value
        },
        pB: {
            handicap: document.getElementById("pB_hc").value,
            wins: document.getElementById("pB_wins").value,
            safeties: document.getElementById("pB_safeties").value,
            b8: document.getElementById("pB_b8").value,
            br: document.getElementById("pB_br").value,
            e8: document.getElementById("pB_e8").value
        },
        matchWinner: document.getElementById("matchWinner").value,
        matchNotes: document.getElementById("matchNotes").value
    };

    fetch("https://script.google.com/macros/s/AKfycbxjPd21vbwaqtxnDHyiwq-232S6vxdG-t6JPd2nQrdi9bbH8EakOr4S_11jDF9uvu4/exec", {
        method: "POST",
        mode: "no-cors", 
        body: JSON.stringify(data)
    })
    .then(() => {
        // --- End Loading State ---
        loader.style.display = "none"; 

        // --- SAVE TO HISTORY ---
        const history = JSON.parse(localStorage.getItem("matchHistory")) || [];
        history.push(data); 
        localStorage.setItem("matchHistory", JSON.stringify(history));
        
        localStorage.setItem("lastSessionActivity", Date.now().toString());

        // --- Update Team Scores ---
        const winnerName = document.getElementById("matchWinner").value;
        const homeTeamName = document.getElementById("team").value;
        const homeRoster = scoresheetinfo[homeTeamName] || [];

        if (homeRoster.includes(winnerName)) {
            scores.home++;
        } else {
            scores.away++;
        }
        localStorage.setItem("teamMatchScores", JSON.stringify(scores));
        updateScoreUI();

        // --- RESET PLAYER FIELDS ---
        const fieldsToReset = [
            "lagWinner", "lagLoser", "matchInnings", "matchWinner",
            "pA_hc", "pA_wins", "pA_safeties", "pA_b8", "pA_br", "pA_e8",
            "pB_hc", "pB_wins", "pB_safeties", "pB_b8", "pB_br", "pB_e8"
        ];

        fieldsToReset.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = el.type === "number" ? 0 : "";
        });

        document.getElementById("lagWinnerHeader").textContent = "Lag Winner";
        document.getElementById("lagLoserHeader").textContent = "Lag Loser";
        document.getElementById("matchNotes").value = "-";
        document.getElementById('pA_coach').checked = false;
        document.getElementById('pB_coach').checked = false;

        // --- HANDLE 5TH MATCH SCENARIO ---
        if ((scores.home + scores.away) >= 5) {
            alert(`Match 5 complete! Final Score: ${scores.home} - ${scores.away}. Resetting session fields, but history is saved.`);
            document.getElementById("team").selectedIndex = 0;
            document.getElementById("opponent").selectedIndex = 0;
            updateRoster(document.getElementById("team"), document.getElementById("teamRoster"));
            updateRoster(document.getElementById("opponent"), document.getElementById("opponentRoster"));
            scores = { home: 0, away: 0 };
            localStorage.setItem("teamMatchScores", JSON.stringify(scores));
            updateScoreUI();
        }

        btn.style.display = "none";
        btn.disabled = false;
        btn.style.opacity = "1";

        saveNow();
        alert("Match submitted!"); // Final confirmation alert
    })
    .catch(err => {
        loader.style.display = "none";
        alert("Error submitting match.");
        btn.disabled = false;
    });
};
    // 8. Save/Load Logic
function saveNow() {
    if (isLoading) return;
    const ids = ["team","opponent","lagWinner","lagLoser","matchInnings","matchWinner","pA_hc","pA_wins","pA_safeties","pA_b8","pA_br","pA_e8","pB_hc","pB_wins","pB_safeties","pB_b8","pB_br","pB_e8","pA_coach","pB_coach","matchNotes"];
    const data = {};
    ids.forEach(id => {
        const el = document.getElementById(id);
        if (el) data[id] = el.type === "checkbox" ? el.checked : el.value;
    });

    // Save the text headers
    data.lwH = document.getElementById("lagWinnerHeader").textContent;
    data.llH = document.getElementById("lagLoserHeader").textContent;

    // ADDED: Save the current match score (Home vs Away)
    data.mScores = JSON.parse(localStorage.getItem("teamMatchScores")) || { home: 0, away: 0 };

    localStorage.setItem(FORM_KEY, JSON.stringify(data));
}
function loadScoresheet() {
    const savedManual = localStorage.getItem("manual_roster_additions");
    if (savedManual) {
        const parsed = JSON.parse(savedManual);
        Object.assign(scoresheetinfo, parsed);
    }

    const raw = localStorage.getItem(FORM_KEY);
    if (!raw) return;
    
    isLoading = true;
    const data = JSON.parse(raw);
    
    Object.keys(data).forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            if (el.type === "checkbox") {
                el.checked = data[id] === true;
            } else {
                el.value = data[id];
            }
        }
    });

    // Restore the text headers
    if (data.lwH) document.getElementById("lagWinnerHeader").textContent = data.lwH;
    if (data.llH) document.getElementById("lagLoserHeader").textContent = data.llH;

    // ADDED: Restore match scores and update the global 'scores' variable
    if (data.mScores) {
        scores = data.mScores;
        localStorage.setItem("teamMatchScores", JSON.stringify(scores));
        updateScoreUI(); // This ensures the numbers at the bottom change immediately
    }

    updateRoster(document.getElementById("team"), document.getElementById("teamRoster"));
    updateRoster(document.getElementById("opponent"), document.getElementById("opponentRoster"));
    updateMatchWinner();
    
    isLoading = false;
}
// 9. Extra UI Helpers
function exportScoresheet() {
    const data = localStorage.getItem(FORM_KEY);
    if (!data) return alert("No data to transfer.");
    const baseUrl = window.location.href.split('?')[0];
    const fullUrl = `${baseUrl}?data=${encodeURIComponent(data)}`;
    document.getElementById('qrModal').style.display = 'flex';
    document.getElementById('qrcode').innerHTML = '';
    new QRCode(document.getElementById('qrcode'), { text: fullUrl, width: 256, height: 256 });
}

function closeQRModal() { document.getElementById('qrModal').style.display = 'none'; }
function toggleNotes() { const box = document.getElementById("notesContainer"); box.style.display = box.style.display === "none" ? "block" : "none"; }

let timerInterval, seconds = 0;
function startTimer() {
    seconds = 0;
    document.getElementById("timerBox").style.display = "block";
    clearInterval(timerInterval);
    timerInterval = setInterval(() => { seconds++; updateTimerDisplay(); }, 1000);
}
function closeTimer() { clearInterval(timerInterval); document.getElementById("timerBox").style.display = "none"; }
function updateTimerDisplay() {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    document.getElementById("timerValue").textContent = `${mins}:${secs < 10 ? '0' + secs : secs}`;
}
// 10. Initialization
window.addEventListener("DOMContentLoaded", () => {
    // Check for 12-hour expiration since last activity
    const lastActivity = localStorage.getItem("lastSessionActivity");
    const twelveHours = 12 * 60 * 60 * 1000;

    if (lastActivity && (Date.now() - parseInt(lastActivity)) > twelveHours) {
        console.log("Session expired. Clearing history and manual players.");
        localStorage.removeItem("matchHistory");
        localStorage.removeItem("manual_roster_additions");
        localStorage.removeItem("teamMatchScores");
        localStorage.removeItem(FORM_KEY);
        localStorage.removeItem("lastSessionActivity");
        scores = { home: 0, away: 0 };
    } else {
        // If within 12 hours, update activity timestamp to "now"
        localStorage.setItem("lastSessionActivity", Date.now().toString());
    }

    const params = new URLSearchParams(window.location.search);
    
    // --- HANDLE MAIN FORM TRANSFER ---
    if (params.has("data")) {
        localStorage.setItem(FORM_KEY, decodeURIComponent(params.get("data")));
        // Clean URL immediately
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    
    // --- HANDLE HISTORY ONLY TRANSFER ---
    if (params.has("hdata")) {
        const hRaw = decodeURIComponent(params.get("hdata"));
        localStorage.setItem("matchHistory", hRaw);
        
        // Clean URL immediately
        window.history.replaceState({}, document.title, window.location.pathname);
        
        alert("Match History Sync Successful!");
        // Refresh history modal if it's currently open
        if (typeof showHistory === "function") showHistory(); 
    }
    
    // Final UI Refresh
    loadScoresheet();
    updateScoreUI();
});
        // Function to show the history modal
function showHistory() {
    const history = JSON.parse(localStorage.getItem("matchHistory")) || [];
    const tbody = document.getElementById("historyTableBody");
    
    if (history.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding:20px;">No matches submitted yet.</td></tr>';
    } else {
        tbody.innerHTML = history.map((m, index) => `
            <tr style="border-bottom: 1px solid #333;">
                <td style="padding:10px;">
                    <div style="font-weight:bold; color:#4af;">Match ${index + 1}</div>
                    ${m.lagWinner} vs ${m.lagLoser}
                </td>
                <td style="padding:10px; text-align:center;">
                    ${m.pA.wins}-${m.pB.wins}<br>
                    <small style="color:#0f0;">Winner: ${m.matchWinner}</small>
                </td>
                <td style="padding:10px; text-align:center;">${m.matchInnings}</td>
            </tr>
        `).join("");
    }
    document.getElementById("historyModal").style.display = "flex";
}

function closeHistory() { document.getElementById("historyModal").style.display = "none"; }

function clearHistory() {
    if(confirm("Clear all match history for this evening?")) {
        localStorage.removeItem("matchHistory");
        showHistory();
    }
}
        function addNewPlayerManual() {
    const homeName = document.getElementById("team").value;
    const awayName = document.getElementById("opponent").value;

    // Check if teams are selected first
    if (!homeName || homeName.includes("Select") || !awayName || awayName.includes("Select")) {
        alert("Please select both teams first.");
        return;
    }

    // Update the labels in the modal
    document.getElementById("homeLabel").textContent = homeName;
    document.getElementById("awayLabel").textContent = awayName;

    // Show the modal
    const modal = document.getElementById("playerModal");
    if (modal) {
        modal.style.display = "flex";
        document.getElementById("manualPlayerName").value = "";
        document.getElementById("manualPlayerName").focus();
    }
}

function closePlayerModal() {
    document.getElementById("playerModal").style.display = "none";
}

function confirmNewPlayer() {
    const nameInput = document.getElementById("manualPlayerName");
    const newName = nameInput.value.trim();
    if (!newName) return;
    
    const side = document.querySelector('input[name="npTeam"]:checked').value;
    const teamDropdown = document.getElementById(side === 'home' ? "team" : "opponent");
    const rosterDiv = document.getElementById(side === 'home' ? "teamRoster" : "opponentRoster");
    const teamName = teamDropdown.value;
    
    if (!teamName || teamName.includes("Select")) {
        alert("Select a team first!");
        return;
    }

    if (!scoresheetinfo[teamName]) scoresheetinfo[teamName] = [];
    
    const exists = scoresheetinfo[teamName].some(p => p.toLowerCase() === newName.toLowerCase());

    if (!exists) {
        // Insert as simple text string
        scoresheetinfo[teamName].push(newName);
        
        // Save to localStorage so they stay on refresh
        localStorage.setItem("manual_roster_additions", JSON.stringify(scoresheetinfo));
        
        updateRoster(teamDropdown, rosterDiv);
        saveNow();
    }
    closePlayerModal();
}
        function exportHistoryOnly() {
    const history = localStorage.getItem("matchHistory");
    if (!history || history === "[]") return alert("No history to transfer.");
    
    const baseUrl = window.location.href.split('?')[0];
    // We use a different key 'hdata' so it doesn't mess with the main form loader
    const fullUrl = `${baseUrl}?hdata=${encodeURIComponent(history)}`;
    
    document.getElementById('qrModal').style.display = 'flex';
    document.getElementById('qrcode').innerHTML = '';
    new QRCode(document.getElementById('qrcode'), { text: fullUrl, width: 256, height: 256 });
}
